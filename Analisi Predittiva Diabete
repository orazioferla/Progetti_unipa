# Random Forest #
table(Diabets$Outcome)
Diabets <- Diabets %>%
  mutate(across(where(is.character), as.factor),
         Outcome=as.factor(Outcome))

set.seed(123)
train_indices <- sample(1:nrow(Diabets), size = 0.75 * nrow(Diabets))
trainData <- Diabets[train_indices, ]  # Dati di training
testData <- Diabets[-train_indices, ]  # Dati di test


# mtry=3 ntree=500
MRF1 <- randomForest(Outcome ~ ., data = trainData, 
                           ntree = 500, 
                           mtry = 3,
                           classwt = c("0" = 1, "1" = 6256 / 1641),
                           importance = TRUE)

