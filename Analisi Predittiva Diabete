# Boosting #
Diabets <- Diabets %>%
  mutate(across(where(is.character), as.factor),
         Outcome = as.numeric(as.character(Outcome)))
table(Diabets$Outcome)
str(Diabets)
set.seed(500)
train_indices <- sample(1:nrow(Diabets), size = 0.75 * nrow(Diabets))
trainData <- Diabets[train_indices, ]  # Dati di training
testData <- Diabets[-train_indices, ]  # Dati di test


M1_Boost <- gbm(Outcome ~ ., 
                data = trainData,
                distribution = "bernoulli",
                interaction.depth = 1,
                n.trees = 300,
                shrinkage = 0.05,
                cv.folds = 5)
gbm.perf(M1_Boost, method = "cv")

M2_Boost <- gbm(Outcome ~ ., 
                data = trainData,
                distribution = "bernoulli",
                interaction.depth = 1,
                n.trees = 1000,
